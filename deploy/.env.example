# Variables de entorno para el servidor Oracle.
# Copia este archivo a deploy/.env y llena los valores REALES.
# NUNCA subas deploy/.env a git (ya está en .gitignore).

# Base de datos (la MISMA de Neon que usa Render)
DATABASE_URL=postgresql://...neon...

# Auth / sesiones
AUTH_BASE_URL=https://miportafolio.uk
JWT_SECRET=pon_un_valor_largo_aleatorio
CRON_SECRET=tu_cron_secret

# Correo (Resend)
RESEND_API_KEY=re_...
RESEND_FROM=Mi Portafolio <no-reply@miportafolio.uk>

# Pagos
MERCADOPAGO_ACCESS_TOKEN=...
MERCADOPAGO_PRECIO_MXN=65
MERCADOPAGO_BACK_URL=https://miportafolio.uk/static/index.html?paid=1
MERCADOPAGO_WEBHOOK_SECRET=...
REVENUECAT_SECRET_API_KEY=sk_...
REVENUECAT_WEBHOOK_AUTH=...

# Respaldo de datos (opcional)
ALPHAVANTAGE_API_KEY=

# Datos de mercado adicionales
BANXICO_SIE_TOKEN=        # curva CETES MX en vivo (banxico.org.mx/SieAPIRest)
FRED_API_KEY=             # curva del Tesoro US (fredaccount.stlouisfed.org/apikeys)
FINNHUB_API_KEY=          # consenso de analistas + earnings (finnhub.io)

# Concurrencia gunicorn (ajusta según la VM: ARM=3-4, AMD micro 1GB=1)
WEB_CONCURRENCY=2
GUNICORN_THREADS=4
